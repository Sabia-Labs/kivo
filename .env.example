# ── API / Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=<CHANGE_THIS_TO_A_SECURE_RANDOM_STRING>
CORS_ORIGIN=http://localhost:3000

# Auth Providers
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/auth/google/callback

# ── Platform AI credentials (fallback for all agents) ───────────────────────────
# Agents without their own API key will use these platform-level credentials.
# NEVER commit real keys — this file is gitignored. Copy from .env.example.
PLATFORM_OPENAI_API_KEY=<YOUR-KEY>
PLATFORM_MODEL_PROVIDER=openai
PLATFORM_MODEL_NAME=gpt-5.4

# LINEAR <YOUR-LINEAR-API-KEY>

ALICLOUD_ACCESS_KEY_ID=<YOUR-KEY>
ALICLOUD_ACCESS_KEY_SECRET=<YOUR-KEY>
ALICLOUD_REGION=cn-shenzhen
