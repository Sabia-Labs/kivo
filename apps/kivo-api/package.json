{
  "name": "@kivo/kivo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Kivo backend REST API — Teams & Agents",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx seed/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.22.3",
    "@langchain/core": "^1.1.42",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@notionhq/notion-mcp-server": "^2.2.1",
    "@tacticlaunch/mcp-linear": "^1.1.2",
    "amqplib": "^0.10.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.41.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
