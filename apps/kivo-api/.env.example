# API Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgres://kivo:kivo@localhost:5432/kivo

# Server port
PORT=4000

# Internal service communication
ADMIN_API_INTERNAL_URL=http://kivo-admin-api.kivo-admin:4001
INTERNAL_SERVICE_TOKEN=your-very-secure-internal-token
